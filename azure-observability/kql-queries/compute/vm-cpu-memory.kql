// =============================================================
// VM CPU and Memory Monitoring Queries
// =============================================================

// --- Top 10 VMs by average CPU (last 1 hour) ---
Perf
| where ObjectName == "Processor" and CounterName == "% Processor Time" and InstanceName == "_Total"
| where TimeGenerated > ago(1h)
| summarize AvgCPU = avg(CounterValue) by Computer
| top 10 by AvgCPU desc

// --- CPU trend per VM (5-minute intervals, last 4 hours) ---
Perf
| where ObjectName == "Processor" and CounterName == "% Processor Time" and InstanceName == "_Total"
| where TimeGenerated > ago(4h)
| summarize AvgCPU = avg(CounterValue) by Computer, bin(TimeGenerated, 5m)
| render timechart

// --- Memory utilization per VM (last 4 hours) ---
Perf
| where ObjectName == "Memory" and CounterName == "% Committed Bytes In Use"
| where TimeGenerated > ago(4h)
| summarize AvgMemory = avg(CounterValue) by Computer, bin(TimeGenerated, 5m)
| render timechart

// --- VMs with sustained high CPU (>85% for 30+ minutes) ---
Perf
| where ObjectName == "Processor" and CounterName == "% Processor Time" and InstanceName == "_Total"
| where TimeGenerated > ago(1h)
| summarize AvgCPU = avg(CounterValue) by Computer, bin(TimeGenerated, 5m)
| where AvgCPU > 85
| summarize HighCPUPeriods = count() by Computer
| where HighCPUPeriods >= 6

// --- Available memory in MB per VM ---
Perf
| where ObjectName == "Memory" and CounterName == "Available MBytes"
| where TimeGenerated > ago(1h)
| summarize AvgAvailableMB = avg(CounterValue) by Computer
| sort by AvgAvailableMB asc
