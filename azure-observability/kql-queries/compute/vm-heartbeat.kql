// =============================================================
// VM Heartbeat and Availability Queries
// =============================================================

// --- Current status of all monitored VMs ---
Heartbeat
| summarize LastHeartbeat = max(TimeGenerated) by Computer, OSType, ComputerIP
| extend Status = iff(LastHeartbeat > ago(5m), "Healthy", "Unhealthy")
| extend MinutesSinceLastBeat = datetime_diff('minute', now(), LastHeartbeat)
| sort by Status desc, MinutesSinceLastBeat desc

// --- VMs that stopped reporting in the last hour ---
Heartbeat
| summarize LastHeartbeat = max(TimeGenerated) by Computer
| where LastHeartbeat between (ago(1h) .. ago(5m))
| extend DowntimeMinutes = datetime_diff('minute', now(), LastHeartbeat)
| sort by DowntimeMinutes desc

// --- Heartbeat count per VM over last 24 hours (availability proxy) ---
Heartbeat
| where TimeGenerated > ago(24h)
| summarize HeartbeatCount = count() by Computer, bin(TimeGenerated, 1h)
| render timechart

// --- Agent version inventory ---
Heartbeat
| where TimeGenerated > ago(1d)
| summarize arg_max(TimeGenerated, *) by Computer
| project Computer, OSType, Version, Category, ComputerIP
| sort by OSType, Version
