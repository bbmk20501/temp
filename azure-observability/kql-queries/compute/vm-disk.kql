// =============================================================
// VM Disk Monitoring Queries
// =============================================================

// --- Disks with less than 15% free space ---
Perf
| where ObjectName == "LogicalDisk" and CounterName == "% Free Space"
| where InstanceName != "_Total"
| where TimeGenerated > ago(1h)
| summarize MinFreePercent = min(CounterValue) by Computer, InstanceName
| where MinFreePercent < 15
| sort by MinFreePercent asc

// --- Disk read/write IOPS per VM ---
Perf
| where ObjectName == "LogicalDisk" and CounterName in ("Disk Reads/sec", "Disk Writes/sec")
| where InstanceName != "_Total"
| where TimeGenerated > ago(4h)
| summarize AvgIOPS = avg(CounterValue) by Computer, InstanceName, CounterName, bin(TimeGenerated, 5m)
| render timechart

// --- Disk latency (average read/write time) ---
Perf
| where ObjectName == "LogicalDisk" and CounterName in ("Avg. Disk sec/Read", "Avg. Disk sec/Write")
| where InstanceName != "_Total"
| where TimeGenerated > ago(4h)
| summarize AvgLatencyMs = avg(CounterValue * 1000) by Computer, InstanceName, CounterName, bin(TimeGenerated, 5m)
| render timechart

// --- Disk space trending — predict full in N days ---
Perf
| where ObjectName == "LogicalDisk" and CounterName == "Free Megabytes"
| where InstanceName != "_Total"
| where TimeGenerated > ago(7d)
| summarize AvgFreeMB = avg(CounterValue) by Computer, InstanceName, bin(TimeGenerated, 1d)
| order by Computer, InstanceName, TimeGenerated asc
| serialize
| extend PrevFreeMB = prev(AvgFreeMB, 1), PrevComputer = prev(Computer, 1), PrevDisk = prev(InstanceName, 1)
| where Computer == PrevComputer and InstanceName == PrevDisk
| extend DailyDeltaMB = PrevFreeMB - AvgFreeMB
| where DailyDeltaMB > 0
| summarize AvgDailyLossMB = avg(DailyDeltaMB), LatestFreeMB = max(AvgFreeMB) by Computer, InstanceName
| extend EstDaysToFull = LatestFreeMB / AvgDailyLossMB
| where EstDaysToFull < 30
| sort by EstDaysToFull asc
