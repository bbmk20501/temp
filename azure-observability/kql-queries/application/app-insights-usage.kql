// =============================================================
// Application Insights Usage and Availability Queries
// =============================================================

// --- Request volume trend ---
requests
| where timestamp > ago(24h)
| summarize RequestCount = count() by bin(timestamp, 15m)
| render timechart

// --- Error rate (%) over time ---
requests
| where timestamp > ago(24h)
| summarize
    TotalRequests = count(),
    FailedRequests = countif(success == false)
    by bin(timestamp, 15m)
| extend ErrorRatePercent = FailedRequests * 100.0 / TotalRequests
| render timechart

// --- Availability test results ---
availabilityResults
| where timestamp > ago(7d)
| summarize
    SuccessRate = countif(success == true) * 100.0 / count(),
    AvgDurationMs = avg(duration)
    by name, bin(timestamp, 1h)
| render timechart

// --- Unique users over time (by anonymous or authenticated ID) ---
requests
| where timestamp > ago(7d)
| summarize UniqueUsers = dcount(user_Id) by bin(timestamp, 1d)
| render timechart

// --- Response codes distribution ---
requests
| where timestamp > ago(24h)
| summarize Count = count() by resultCode
| sort by Count desc
| render piechart
