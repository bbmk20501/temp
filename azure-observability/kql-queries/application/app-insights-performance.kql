// =============================================================
// Application Insights Performance Queries
// =============================================================

// --- Request duration percentiles (P50, P90, P99) ---
requests
| where timestamp > ago(4h)
| summarize
    P50 = percentile(duration, 50),
    P90 = percentile(duration, 90),
    P99 = percentile(duration, 99)
    by bin(timestamp, 5m)
| render timechart

// --- Slowest endpoints (avg duration, last 1 hour) ---
requests
| where timestamp > ago(1h)
| where success == true
| summarize AvgDurationMs = avg(duration), RequestCount = count() by name
| where RequestCount > 10
| top 10 by AvgDurationMs desc

// --- Failed requests by endpoint ---
requests
| where timestamp > ago(1h)
| where success == false
| summarize FailedCount = count() by name, resultCode
| sort by FailedCount desc

// --- Dependency call performance (external services, databases) ---
dependencies
| where timestamp > ago(4h)
| summarize
    AvgDurationMs = avg(duration),
    FailureRate = countif(success == false) * 100.0 / count()
    by target, type, bin(timestamp, 5m)
| render timechart

// --- Exception rate over time ---
exceptions
| where timestamp > ago(24h)
| summarize ExceptionCount = count() by type, bin(timestamp, 1h)
| render timechart

// --- Top exceptions by type ---
exceptions
| where timestamp > ago(24h)
| summarize Count = count() by type, outerMessage
| top 10 by Count desc
