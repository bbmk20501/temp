// =============================================================
// Security Sign-In Analysis Queries
// =============================================================

// --- Failed login attempts by account (last 24 hours) ---
SecurityEvent
| where TimeGenerated > ago(24h)
| where EventID == 4625
| summarize FailedAttempts = count() by TargetAccount, IpAddress, LogonTypeName
| sort by FailedAttempts desc

// --- Potential brute force — >20 failures from same IP in 10 min ---
SecurityEvent
| where TimeGenerated > ago(1h)
| where EventID == 4625
| summarize FailedAttempts = count() by IpAddress, bin(TimeGenerated, 10m)
| where FailedAttempts > 20

// --- Successful logins after multiple failures (credential stuffing pattern) ---
let FailedLogins = SecurityEvent
| where TimeGenerated > ago(1h)
| where EventID == 4625
| summarize FailedCount = count() by TargetAccount, IpAddress
| where FailedCount > 5;
SecurityEvent
| where TimeGenerated > ago(1h)
| where EventID == 4624
| join kind=inner FailedLogins on $left.TargetAccount == $right.TargetAccount, $left.IpAddress == $right.IpAddress
| project TimeGenerated, TargetAccount, IpAddress, LogonTypeName, FailedCount

// --- Logon activity by type over time ---
SecurityEvent
| where TimeGenerated > ago(24h)
| where EventID in (4624, 4625)
| extend Outcome = iff(EventID == 4624, "Success", "Failure")
| summarize Count = count() by Outcome, bin(TimeGenerated, 1h)
| render timechart

// --- Sign-ins from unusual locations (Azure AD) ---
SigninLogs
| where TimeGenerated > ago(7d)
| where ResultType != 0
| summarize FailedSignIns = count() by Location, UserPrincipalName, IPAddress, ResultDescription
| sort by FailedSignIns desc
