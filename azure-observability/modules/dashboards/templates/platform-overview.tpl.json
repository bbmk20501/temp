{
  "lenses": {
    "0": {
      "order": 0,
      "parts": {
        "0": {
          "position": { "x": 0, "y": 0, "colSpan": 6, "rowSpan": 4 },
          "metadata": {
            "type": "Extension/Microsoft_OperationsManagementSuite_Workspace/PartType/LogsDashboardPart",
            "inputs": [
              { "name": "ComponentId", "value": "${workspace_id}" },
              {
                "name": "Query",
                "value": "AzureMetrics\n| where ResourceProvider == 'MICROSOFT.NETWORK'\n| where MetricName == 'FirewallHealth'\n| summarize AvgHealth = avg(Average) by Resource, bin(TimeGenerated, 5m)\n| render timechart"
              },
              { "name": "PartTitle", "value": "Azure Firewall Health" },
              { "name": "VisualizationType", "value": "linechart" },
              { "name": "TimeRange", "value": "PT4H" }
            ]
          }
        },
        "1": {
          "position": { "x": 6, "y": 0, "colSpan": 6, "rowSpan": 4 },
          "metadata": {
            "type": "Extension/Microsoft_OperationsManagementSuite_Workspace/PartType/LogsDashboardPart",
            "inputs": [
              { "name": "ComponentId", "value": "${workspace_id}" },
              {
                "name": "Query",
                "value": "AZFWNetworkRule\n| summarize Allowed = countif(Action == 'Allow'), Denied = countif(Action == 'Deny') by bin(TimeGenerated, 15m)\n| render timechart"
              },
              { "name": "PartTitle", "value": "Firewall Network Rules — Allow vs Deny" },
              { "name": "VisualizationType", "value": "linechart" },
              { "name": "TimeRange", "value": "PT4H" }
            ]
          }
        },
        "2": {
          "position": { "x": 0, "y": 4, "colSpan": 6, "rowSpan": 4 },
          "metadata": {
            "type": "Extension/Microsoft_OperationsManagementSuite_Workspace/PartType/LogsDashboardPart",
            "inputs": [
              { "name": "ComponentId", "value": "${workspace_id}" },
              {
                "name": "Query",
                "value": "AzureDiagnostics\n| where ResourceType == 'APPLICATIONGATEWAYS'\n| where Category == 'ApplicationGatewayAccessLog'\n| summarize TotalRequests = count(), ServerErrors = countif(httpStatus_d >= 500) by bin(TimeGenerated, 15m)\n| extend ErrorRatePct = round(ServerErrors * 100.0 / TotalRequests, 2)\n| render timechart"
              },
              { "name": "PartTitle", "value": "App Gateway — Request Volume & 5xx Error Rate" },
              { "name": "VisualizationType", "value": "linechart" },
              { "name": "TimeRange", "value": "PT4H" }
            ]
          }
        },
        "3": {
          "position": { "x": 6, "y": 4, "colSpan": 6, "rowSpan": 4 },
          "metadata": {
            "type": "Extension/Microsoft_OperationsManagementSuite_Workspace/PartType/LogsDashboardPart",
            "inputs": [
              { "name": "ComponentId", "value": "${workspace_id}" },
              {
                "name": "Query",
                "value": "AzureMetrics\n| where ResourceProvider == 'MICROSOFT.NETWORK'\n| where MetricName in ('HealthyHostCount', 'UnhealthyHostCount')\n| summarize AvgCount = avg(Average) by Resource, MetricName, bin(TimeGenerated, 5m)\n| render timechart"
              },
              { "name": "PartTitle", "value": "App Gateway — Backend Health" },
              { "name": "VisualizationType", "value": "linechart" },
              { "name": "TimeRange", "value": "PT4H" }
            ]
          }
        },
        "4": {
          "position": { "x": 0, "y": 8, "colSpan": 6, "rowSpan": 4 },
          "metadata": {
            "type": "Extension/Microsoft_OperationsManagementSuite_Workspace/PartType/LogsDashboardPart",
            "inputs": [
              { "name": "ComponentId", "value": "${workspace_id}" },
              {
                "name": "Query",
                "value": "AzureMetrics\n| where ResourceProvider == 'MICROSOFT.NETWORK'\n| where MetricName == 'DipAvailability'\n| summarize AvgHealthPct = avg(Average) by Resource, bin(TimeGenerated, 5m)\n| render timechart"
              },
              { "name": "PartTitle", "value": "Load Balancer — Backend Health Probe" },
              { "name": "VisualizationType", "value": "linechart" },
              { "name": "TimeRange", "value": "PT4H" }
            ]
          }
        },
        "5": {
          "position": { "x": 6, "y": 8, "colSpan": 6, "rowSpan": 4 },
          "metadata": {
            "type": "Extension/Microsoft_OperationsManagementSuite_Workspace/PartType/LogsDashboardPart",
            "inputs": [
              { "name": "ComponentId", "value": "${workspace_id}" },
              {
                "name": "Query",
                "value": "AzureMetrics\n| where ResourceProvider == 'MICROSOFT.NETWORK'\n| where MetricName in ('AllocatedSnatPorts', 'UsedSnatPorts')\n| summarize AvgValue = avg(Average) by Resource, MetricName, bin(TimeGenerated, 5m)\n| render timechart"
              },
              { "name": "PartTitle", "value": "Load Balancer — SNAT Port Usage" },
              { "name": "VisualizationType", "value": "linechart" },
              { "name": "TimeRange", "value": "PT4H" }
            ]
          }
        },
        "6": {
          "position": { "x": 0, "y": 12, "colSpan": 6, "rowSpan": 4 },
          "metadata": {
            "type": "Extension/Microsoft_OperationsManagementSuite_Workspace/PartType/LogsDashboardPart",
            "inputs": [
              { "name": "ComponentId", "value": "${workspace_id}" },
              {
                "name": "Query",
                "value": "AzureMetrics\n| where ResourceProvider == 'MICROSOFT.NETWORK'\n| where MetricName in ('ArpAvailability', 'BgpAvailability')\n| summarize AvgPct = avg(Average) by Resource, MetricName, bin(TimeGenerated, 5m)\n| render timechart"
              },
              { "name": "PartTitle", "value": "ExpressRoute — ARP & BGP Availability" },
              { "name": "VisualizationType", "value": "linechart" },
              { "name": "TimeRange", "value": "PT24H" }
            ]
          }
        },
        "7": {
          "position": { "x": 6, "y": 12, "colSpan": 6, "rowSpan": 4 },
          "metadata": {
            "type": "Extension/Microsoft_OperationsManagementSuite_Workspace/PartType/LogsDashboardPart",
            "inputs": [
              { "name": "ComponentId", "value": "${workspace_id}" },
              {
                "name": "Query",
                "value": "AzureMetrics\n| where ResourceProvider == 'MICROSOFT.NETWORK'\n| where MetricName in ('BitsInPerSecond', 'BitsOutPerSecond')\n| summarize AvgBps = avg(Average) by Resource, MetricName, bin(TimeGenerated, 5m)\n| extend AvgMbps = round(AvgBps / 1000000.0, 2)\n| project TimeGenerated, Resource, MetricName, AvgMbps\n| render timechart"
              },
              { "name": "PartTitle", "value": "ExpressRoute — Circuit Throughput (Mbps)" },
              { "name": "VisualizationType", "value": "linechart" },
              { "name": "TimeRange", "value": "PT4H" }
            ]
          }
        },
        "8": {
          "position": { "x": 0, "y": 16, "colSpan": 6, "rowSpan": 4 },
          "metadata": {
            "type": "Extension/Microsoft_OperationsManagementSuite_Workspace/PartType/LogsDashboardPart",
            "inputs": [
              { "name": "ComponentId", "value": "${workspace_id}" },
              {
                "name": "Query",
                "value": "AZFWDnsQuery\n| summarize QueryCount = count() by bin(TimeGenerated, 15m)\n| render timechart"
              },
              { "name": "PartTitle", "value": "Firewall DNS Proxy — Query Volume" },
              { "name": "VisualizationType", "value": "linechart" },
              { "name": "TimeRange", "value": "PT4H" }
            ]
          }
        },
        "9": {
          "position": { "x": 6, "y": 16, "colSpan": 6, "rowSpan": 4 },
          "metadata": {
            "type": "Extension/Microsoft_OperationsManagementSuite_Workspace/PartType/LogsDashboardPart",
            "inputs": [
              { "name": "ComponentId", "value": "${workspace_id}" },
              {
                "name": "Query",
                "value": "AZFWThreatIntel\n| summarize ThreatHits = count() by bin(TimeGenerated, 1h)\n| render timechart"
              },
              { "name": "PartTitle", "value": "Firewall — Threat Intel Hits" },
              { "name": "VisualizationType", "value": "barchart" },
              { "name": "TimeRange", "value": "P7D" }
            ]
          }
        }
      }
    }
  }
}
